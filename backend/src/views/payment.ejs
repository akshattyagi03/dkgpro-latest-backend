<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DKGPro - Payment Checkout</title>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            width: 100%;
            max-width: 520px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
        }
        h1 { color: #667eea; text-align: center; margin-bottom: 8px; font-size: 1.8em; }
        p.subtitle { text-align: center; color: #999; margin-bottom: 30px; font-size: 0.9em; }
        h3 { color: #667eea; margin-bottom: 12px; font-size: 1em; }
        .divider { height: 1px; background: #e0e0e0; margin: 20px 0; }

        /* Cart Items */
        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
            font-size: 0.9em;
        }
        .cart-item:last-child { border-bottom: none; }
        .cart-item .name { color: #333; font-weight: 500; }
        .cart-item .qty { color: #999; font-size: 0.85em; }
        .cart-item .price { color: #667eea; font-weight: 600; }
        .cart-empty { color: #999; text-align: center; padding: 15px 0; font-size: 0.9em; }

        /* Summary */
        .summary {
            background: #f5f5f5;
            border-radius: 8px;
            padding: 15px;
            margin: 20px 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .summary p { color: #666; font-size: 0.9em; }
        .amount { font-size: 1.6em; color: #667eea; font-weight: bold; }

        /* Address */
        .form-group { margin-bottom: 18px; }
        label { display: block; margin-bottom: 6px; color: #333; font-weight: 600; font-size: 0.9em; }
        input {
            width: 100%; padding: 12px; border: 2px solid #e0e0e0;
            border-radius: 8px; font-size: 1em; transition: border-color 0.3s;
        }
        input:focus { outline: none; border-color: #667eea; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }

        /* Button */
        button {
            width: 100%; padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white; border: none; border-radius: 8px;
            font-size: 1em; font-weight: 600; cursor: pointer; margin-top: 10px;
        }
        button:hover { opacity: 0.9; }

        /* Status */
        .status { padding: 12px; border-radius: 8px; margin-bottom: 20px; display: none; font-size: 0.9em; font-weight: 500; }
        .status.show { display: block; }
        .status.error { background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
        .status.success { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
        .status.info { background: #d1ecf1; color: #0c5460; border: 1px solid #bee5eb; }

        @media (max-width: 500px) {
            .card { padding: 25px; }
            .form-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>💳 Checkout</h1>
        <p class="subtitle">Complete your order securely</p>

        <div id="status" class="status"></div>

        <!-- Cart Items -->
        <h3>🛒 Cart Items</h3>
        <% if (cartItems.length === 0) { %>
            <p class="cart-empty">Your cart is empty. Add items before checkout.</p>
        <% } else { %>
            <% cartItems.forEach(item => { %>
                <div class="cart-item">
                    <div>
                        <div class="name"><%= item.product.name %></div>
                        <div class="qty">Qty: <%= item.quantity %></div>
                    </div>
                    <div class="price">₹<%= (item.product.price * item.quantity).toLocaleString() %></div>
                </div>
            <% }) %>
        <% } %>

        <!-- Total -->
        <div class="summary">
            <p>Total Amount</p>
            <div class="amount">₹<%= totalAmount.toLocaleString() %></div>
        </div>

        <div class="divider"></div>

        <!-- Shipping Address -->
        <h3>📍 Shipping Address</h3>
        <div class="form-group">
            <label>Street</label>
            <input type="text" id="street" value="42 MG Road">
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>City</label>
                <input type="text" id="city" value="Mumbai">
            </div>
            <div class="form-group">
                <label>State</label>
                <input type="text" id="state" value="Maharashtra">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Zip Code</label>
                <input type="text" id="zipCode" value="400001">
            </div>
            <div class="form-group">
                <label>Country</label>
                <input type="text" id="country" value="India">
            </div>
        </div>

        <% if (cartItems.length > 0) { %>
            <button onclick="processPayment()">Pay ₹<%= totalAmount.toLocaleString() %></button>
        <% } %>
    </div>

    <script>
        const RAZORPAY_KEY_ID = '<%= razorpayKeyId %>'
        const TOTAL_AMOUNT = <%= totalAmount %>

        function showStatus(msg, type) {
            const el = document.getElementById('status')
            el.textContent = msg
            el.className = `status show ${type}`
        }

        async function processPayment() {
            const shippingAddress = {
                street: document.getElementById('street').value,
                city: document.getElementById('city').value,
                state: document.getElementById('state').value,
                zipCode: document.getElementById('zipCode').value,
                country: document.getElementById('country').value
            }

            if (!shippingAddress.street || !shippingAddress.city) {
                showStatus('Please fill in the shipping address', 'error')
                return
            }

            showStatus('Creating order...', 'info')

            try {
                const res = await fetch('/users/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ totalAmount: TOTAL_AMOUNT, shippingAddress })
                })

                const data = await res.json()

                if (!res.ok) {
                    showStatus(data.message || 'Failed to create order', 'error')
                    return
                }

                showStatus('Opening payment gateway...', 'info')

                const rzp = new Razorpay({
                    key: data.keyId,
                    amount: TOTAL_AMOUNT * 100,
                    currency: 'INR',
                    order_id: data.razorpayOrderId,
                    handler: async (response) => {
                        showStatus('Verifying payment...', 'info')

                        const verifyRes = await fetch('/users/verify-payment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            credentials: 'include',
                            body: JSON.stringify({
                                razorpayOrderId: response.razorpay_order_id,
                                razorpayPaymentId: response.razorpay_payment_id,
                                razorpaySignature: response.razorpay_signature,
                                orderMeta: data._orderMeta
                            })
                        })

                        const verifyData = await verifyRes.json()

                        if (verifyRes.ok) {
                            showStatus('✅ Payment successful! Order confirmed.', 'success')
                        } else {
                            showStatus(verifyData.message || 'Verification failed', 'error')
                        }
                    },
                    prefill: { name: 'Customer', email: 'customer@example.com', contact: '9876543210' },
                    theme: { color: '#667eea' },
                    modal: { ondismiss: () => showStatus('Payment cancelled', 'error') }
                })

                rzp.on('payment.failed', (r) => showStatus(`Payment failed: ${r.error.description}`, 'error'))
                rzp.open()

            } catch (err) {
                showStatus(`Error: ${err.message}`, 'error')
            }
        }
    </script>
</body>
</html>
