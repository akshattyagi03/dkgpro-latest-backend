PORT=6969
MONGODB_URI=mongodb://localhost:27017/dkgpro
JWT_SECRET_KEY=your_jwt_secret_key
NODE_ENV=development
EMAIL_USER=
EMAIL_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Admin UI (dkg_admin Vite default port). Required when the browser calls the API directly (credentials + CORS).
FRONTEND_URL=http://localhost:8080

# Image uploads (admin products, categories, blogs, etc.)
# If all three are set, files go to Cloudinary. Otherwise files are stored under public/uploads/ (served at /uploads/...).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional - for S3 file uploads (multer-s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
