<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DKGPro - Payment Checkout</title>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            max-width: 500px;
            width: 100%;
        }

        .card {
            background: white;
            border-radius: 15px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            color: #667eea;
            font-size: 2em;
            margin-bottom: 10px;
        }

        .header p {
            color: #666;
            font-size: 0.95em;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-weight: 600;
            font-size: 0.95em;
        }

        input, textarea, select {
            width: 100%;
            padding: 12px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1em;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        input:focus, textarea:focus, select:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 10px rgba(102, 126, 234, 0.2);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .button-group {
            display: flex;
            gap: 10px;
            margin-top: 30px;
        }

        button {
            flex: 1;
            padding: 14px 20px;
            border: none;
            border-radius: 8px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #f0f0f0;
            color: #333;
        }

        .btn-secondary:hover {
            background: #e0e0e0;
        }

        .status-message {
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: none;
            font-weight: 500;
        }

        .status-message.show {
            display: block;
        }

        .status-message.success {
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .status-message.error {
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .status-message.info {
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }

        .info-box {
            background: #e3f2fd;
            border-left: 4px solid #2196f3;
            padding: 15px;
            border-radius: 5px;
            margin-bottom: 20px;
            color: #1565c0;
            font-size: 0.9em;
        }

        .divider {
            height: 1px;
            background: #e0e0e0;
            margin: 25px 0;
        }

        .order-summary {
            background: #f9f9f9;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .order-summary h3 {
            color: #667eea;
            margin-bottom: 10px;
            font-size: 0.95em;
        }

        .amount-display {
            font-size: 1.5em;
            color: #667eea;
            font-weight: bold;
            margin-top: 10px;
        }

        @media (max-width: 600px) {
            .card {
                padding: 25px;
            }

            .header h1 {
                font-size: 1.5em;
            }

            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="header">
                <h1>💳 Payment Checkout</h1>
                <p>Complete your order securely</p>
            </div>

            <div id="statusMessage" class="status-message"></div>

            <div class="info-box">
                ℹ️ Fill in your details and click "Pay Now" to complete the payment.
            </div>

            <form id="paymentForm">
                <div class="form-group">
                    <label>Order Amount (₹)</label>
                    <input type="number" id="amount" value="50000" min="100" required>
                </div>

                <div class="divider"></div>

                <h3 style="color: #667eea; margin-bottom: 15px; font-size: 1.1em;">📍 Shipping Address</h3>

                <div class="form-group">
                    <label>Street Address</label>
                    <input type="text" id="street" value="123 Main Street" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>City</label>
                        <input type="text" id="city" value="Mumbai" required>
                    </div>
                    <div class="form-group">
                        <label>State</label>
                        <input type="text" id="state" value="Maharashtra" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Zip Code</label>
                        <input type="text" id="zipCode" value="400001" required>
                    </div>
                    <div class="form-group">
                        <label>Country</label>
                        <input type="text" id="country" value="India" required>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="order-summary">
                    <h3>Order Summary</h3>
                    <p>Amount to Pay:</p>
                    <div class="amount-display">₹<span id="displayAmount">50000</span></div>
                </div>

                <div class="button-group">
                    <button type="button" class="btn-primary" onclick="processPayment()">Pay Now</button>
                    <button type="button" class="btn-secondary" onclick="resetForm()">Clear</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const RAZORPAY_KEY_ID = '<%= razorpayKeyId %>';

        document.getElementById('amount').addEventListener('change', function() {
            document.getElementById('displayAmount').textContent = this.value;
        });

        function showStatus(message, type = 'info') {
            const element = document.getElementById('statusMessage');
            element.textContent = message;
            element.className = `status-message show ${type}`;
            setTimeout(() => {
                element.classList.remove('show');
            }, 5000);
        }

        function resetForm() {
            document.getElementById('paymentForm').reset();
            document.getElementById('displayAmount').textContent = '50000';
        }

        async function processPayment() {
            try {
                const amount = document.getElementById('amount').value;
                const shippingAddress = {
                    street: document.getElementById('street').value,
                    city: document.getElementById('city').value,
                    state: document.getElementById('state').value,
                    zipCode: document.getElementById('zipCode').value,
                    country: document.getElementById('country').value
                };

                if (!amount || amount < 100) {
                    showStatus('Amount must be at least ₹100', 'error');
                    return;
                }

                showStatus('Creating order...', 'info');

                const createResponse = await fetch('/users/create-order', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ totalAmount: parseInt(amount), shippingAddress })
                });

                const createData = await createResponse.json();

                if (!createResponse.ok) {
                    showStatus(`Error: ${createData.message}`, 'error');
                    return;
                }

                const { razorpayOrderId, keyId } = createData;

                showStatus('Opening payment gateway...', 'info');

                const options = {
                    key: keyId,
                    amount: parseInt(amount) * 100,
                    currency: 'INR',
                    order_id: razorpayOrderId,
                    handler: async (response) => {
                        await handlePaymentSuccess(response);
                    },
                    prefill: {
                        name: 'Customer',
                        email: 'customer@example.com',
                        contact: '9876543210'
                    },
                    theme: { color: '#667eea' },
                    modal: {
                        ondismiss: () => {
                            showStatus('Payment cancelled', 'error');
                        }
                    }
                };

                const rzp = new Razorpay(options);
                rzp.open();

                rzp.on('payment.failed', (response) => {
                    showStatus(`Payment failed: ${response.error.description}`, 'error');
                });

            } catch (error) {
                showStatus(`Error: ${error.message}`, 'error');
            }
        }

        async function handlePaymentSuccess(response) {
            try {
                showStatus('Verifying payment...', 'info');

                const verifyResponse = await fetch('/users/verify-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        razorpayOrderId: response.razorpay_order_id,
                        razorpayPaymentId: response.razorpay_payment_id,
                        razorpaySignature: response.razorpay_signature
                    })
                });

                const verifyData = await verifyResponse.json();

                if (verifyResponse.ok) {
                    showStatus('✅ Payment successful! Order confirmed.', 'success');
                    resetForm();
                    setTimeout(() => {
                        window.location.href = '/payment-success?orderId=' + verifyData.order._id;
                    }, 2000);
                } else {
                    showStatus(`Verification failed: ${verifyData.message}`, 'error');
                }
            } catch (error) {
                showStatus(`Error: ${error.message}`, 'error');
            }
        }

        window.addEventListener('load', () => {
            if (!RAZORPAY_KEY_ID || RAZORPAY_KEY_ID.includes('undefined')) {
                showStatus('⚠️ Razorpay key not configured.', 'error');
            }
        });
    </script>
</body>
</html>
